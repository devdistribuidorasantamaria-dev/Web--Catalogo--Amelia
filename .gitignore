# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencias
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# tests
/coverage

# next.js
/.next/
/out/

# build
/build

# varios
.DS_Store
Thumbs.db
*.pem

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Variables de entorno: nunca se suben (.env.local trae REVALIDATE_SECRET).
# .env.example sí se sube, porque es el contrato para desplegar.
.env
.env*.local
.env.production
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editores
/.idea
/.vscode
/.zed
